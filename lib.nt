use arrays
use fmt
use json
use strings

class Parser {
    var array[string] lines
    var int pos

    fun init(view string source) {
        this.lines = strings.split_array(source, "\n")
        this.pos = 0
    }

    fun skip_ignored() {
        while (this.pos < arrays.length(this.lines)) {
            var line = arrays.get(this.lines, this.pos)
            var trimmed = strings.trim(line)
            if (strings.is_empty(trimmed) || strings.starts_with(trimmed, "#")) {
                this.pos = this.pos + 1
            } else {
                return
            }
        }
    }

    fun indent(view string line) -> int {
        var count = 0
        var i = 0
        while (i < strings.length(line)) {
            var c = strings.char_at(line, i)
            if (c == " " || c == "\t") {
                count = count + 1
                i = i + strings.length(c)
            } else {
                return count
            }
        }
        return count
    }

    fun body(view string line, int indentation) -> string {
        return strings.trim(strings.substring(line, indentation, -1))
    }

    fun fail(view string message) -> string {
        throw "yaml.parse: " + copy(message) + " at line " + fmt.i64_to_str(this.pos + 1)
        return ""
    }

    fun parse_block(int indentation) -> string {
        this.skip_ignored()
        if (this.pos >= arrays.length(this.lines)) {
            return "{}"
        }
        var first_line = arrays.get(this.lines, this.pos)
        var first_body = this.body(first_line, this.indent(first_line))
        if (first_body == "-" || strings.starts_with(first_body, "- ")) {
            var values = arrays.new()
            while (this.pos < arrays.length(this.lines)) {
                this.skip_ignored()
                if (this.pos >= arrays.length(this.lines)) {
                    break
                }
                var line = arrays.get(this.lines, this.pos)
                var current_indent = this.indent(line)
                if (current_indent < indentation) {
                    break
                }
                if (current_indent != indentation) {
                    this.fail("unexpected sequence indentation")
                }
                var content = this.body(line, indentation)
                if (content != "-" && !strings.starts_with(content, "- ")) {
                    break
                }
                var value = strings.trim(strings.substring(content, 1, -1))
                this.pos = this.pos + 1
                if (strings.is_empty(value)) {
                    this.skip_ignored()
                    if (this.pos < arrays.length(this.lines)) {
                        var child_line = arrays.get(this.lines, this.pos)
                        var child_indent = this.indent(child_line)
                        if (child_indent > indentation) {
                            value = this.parse_block(child_indent)
                        } else {
                            value = "null"
                        }
                    } else {
                        value = "null"
                    }
                } else {
                    value = parse_value(value)
                }
                arrays.push(values, value)
            }
            return "[" + strings.join_all(values, ",") + "]"
        }

        var entries = arrays.new()
        while (this.pos < arrays.length(this.lines)) {
            this.skip_ignored()
            if (this.pos >= arrays.length(this.lines)) {
                break
            }
            var line = arrays.get(this.lines, this.pos)
            var current_indent = this.indent(line)
            if (current_indent < indentation) {
                break
            }
            if (current_indent > indentation) {
                this.fail("unexpected indentation")
            }
            var content = this.body(line, indentation)
            if (content == "-" || strings.starts_with(content, "- ")) {
                this.fail("expected a mapping")
            }
            var colon = strings.index_of(content, ":", 0)
            if (colon < 0) {
                this.fail("expected ':'")
            }
            var key = strings.trim(strings.substring(content, 0, colon))
            if (strings.is_empty(key)) {
                this.fail("empty key")
            }
            var value = strings.trim(strings.substring(content, colon + 1, -1))
            this.pos = this.pos + 1
            if (strings.is_empty(value)) {
                this.skip_ignored()
                if (this.pos < arrays.length(this.lines)) {
                    var child_line = arrays.get(this.lines, this.pos)
                    var child_indent = this.indent(child_line)
                    if (child_indent > indentation) {
                        value = this.parse_block(child_indent)
                    } else {
                        value = "{}"
                    }
                } else {
                    value = "{}"
                }
            } else {
                value = parse_value(value)
            }
            arrays.push(entries, json.escape_string(key) + "\t" + value)
        }
        return build_object(entries)
    }

    fun parse_document() -> string {
        this.skip_ignored()
        if (this.pos >= arrays.length(this.lines)) {
            return "{}"
        }
        var line = arrays.get(this.lines, this.pos)
        var indentation = this.indent(line)
        var content = this.body(line, indentation)
        if (content == "-" || strings.starts_with(content, "- ")) {
            this.fail("top-level sequences are not supported, use inline flow")
        }
        return this.parse_block(indentation)
    }
}

fun split_flow(view string text) -> array[string] {
    var values = arrays.new()
    var current = ""
    var depth = 0
    var quote = ""
    var escaped = false
    var i = 0
    while (i < strings.length(text)) {
        var c = strings.char_at(text, i)
        if (escaped) {
            current = current + c
            escaped = false
        } elif (quote == "\\" && c == "\\") {
            current = current + c
            escaped = true
        } elif ((c == "\"" || c == "'") && strings.is_empty(quote)) {
            quote = c
            current = current + c
        } elif (c == quote) {
            quote = ""
            current = current + c
        } elif (!strings.is_empty(quote)) {
            current = current + c
        } elif (c == "[" || c == "{") {
            depth = depth + 1
            current = current + c
        } elif (c == "]" || c == "}") {
            depth = depth - 1
            current = current + c
        } elif (c == "," && depth == 0) {
            if (!strings.is_empty(strings.trim(current))) {
                arrays.push(values, strings.trim(current))
            }
            current = ""
        } else {
            current = current + c
        }
        i = i + strings.length(c)
    }
    if (!strings.is_empty(strings.trim(current))) {
        arrays.push(values, strings.trim(current))
    }
    return values
}

fun parse_value(view string raw) -> string {
    var value = strings.trim(raw)
    if (strings.is_empty(value)) {
        return "\"\""
    }
    var length = strings.length(value)
    if (length >= 2 && ((strings.starts_with(value, "\"") && strings.ends_with(value, "\"")) || (strings.starts_with(value, "'") && strings.ends_with(value, "'")))) {
        return json.escape_string(strings.substring(value, 1, length - 1))
    }
    if (value == "true" || value == "false") {
        return value
    }
    if (value == "null" || value == "~") {
        return "null"
    }
    if (fmt.is_int(value) || fmt.is_float(value)) {
        return value
    }
    if (strings.starts_with(value, "[") && strings.ends_with(value, "]")) {
        var inner = strings.trim(strings.substring(value, 1, length - 1))
        var items = split_flow(inner)
        var output = arrays.new()
        for (var i = 0; i < arrays.length(items); i = i + 1) {
            arrays.push(output, parse_value(arrays.get(items, i)))
        }
        return "[" + strings.join_all(output, ",") + "]"
    }
    if (strings.starts_with(value, "{") && strings.ends_with(value, "}")) {
        var inner = strings.trim(strings.substring(value, 1, length - 1))
        var items = split_flow(inner)
        var entries = arrays.new()
        for (var i = 0; i < arrays.length(items); i = i + 1) {
            var item = arrays.get(items, i)
            var colon = strings.index_of(item, ":", 0)
            if (colon < 0) {
                throw "yaml.parse: expected ':' in flow mapping"
            }
            var key = strings.trim(strings.substring(item, 0, colon))
            var item_value = parse_value(strings.substring(item, colon + 1, -1))
            if (strings.starts_with(key, "\"") && strings.ends_with(key, "\"")) {
                arrays.push(entries, key + "\t" + item_value)
            } else {
                arrays.push(entries, json.escape_string(key) + "\t" + item_value)
            }
        }
        return build_object(entries)
    }
    return json.escape_string(value)
}

fun entry_key(view string entry) -> string {
    return strings.substring(entry, 0, strings.index_of(entry, "\t", 0))
}

fun entry_value(view string entry) -> string {
    return strings.substring(entry, strings.index_of(entry, "\t", 0) + 1, -1)
}

fun build_object(view array[string] entries) -> string {
    var output = "{"
    for (var i = 0; i < arrays.length(entries); i = i + 1) {
        if (i > 0) {
            output = output + ","
        }
        var entry = arrays.get(entries, i)
        output = output + entry_key(entry) + ":" + entry_value(entry)
    }
    return output + "}"
}

fun spaces(int count) -> string {
    return strings.repeat(" ", count)
}

fun object_keys(view string document) -> array[string] {
    var keys = arrays.new()
    var depth = 0
    var in_string = false
    var escaped = false
    var i = 0
    while (i < strings.length(document)) {
        var c = strings.char_at(document, i)
        if (in_string) {
            if (escaped) {
                escaped = false
            } elif (c == "\\") {
                escaped = true
            } elif (c == "\"") {
                in_string = false
            }
        } elif (c == "{") {
            depth = depth + 1
        } elif (c == "}") {
            depth = depth - 1
        } elif (c == "\"" && depth == 1) {
            var start = i + 1
            var end = start
            var key_escaped = false
            while (end < strings.length(document)) {
                var key_char = strings.char_at(document, end)
                if (key_escaped) {
                    key_escaped = false
                } elif (key_char == "\\") {
                    key_escaped = true
                } elif (key_char == "\"") {
                    break
                }
                end = end + strings.length(key_char)
            }
            var after = end + 1
            while (after < strings.length(document) && strings.char_at(document, after) == " ") {
                after = after + 1
            }
            if (after < strings.length(document) && strings.char_at(document, after) == ":") {
                arrays.push(keys, strings.substring(document, start, end))
            }
            i = end
        }
        i = i + strings.length(c)
    }
    return keys
}

fun yaml_scalar(view string value) -> string {
    return copy(value)
}

fun emit_array(view string value, int indentation) -> string {
    var output = ""
    var count = json.length(value)
    for (var i = 0; i < count; i = i + 1) {
        var item = json.at(value, i)
        var prefix = spaces(indentation) + "-"
        if (strings.starts_with(item, "{") && item != "{}") {
            output = output + prefix + "\n" + emit_object(item, indentation + 2)
        } elif (strings.starts_with(item, "[") && item != "[]") {
            output = output + prefix + "\n" + emit_array(item, indentation + 2)
        } else {
            output = output + prefix + " " + yaml_scalar(item) + "\n"
        }
    }
    return output
}

fun emit_object(view string document, int indentation) -> string {
    var output = ""
    var keys = object_keys(document)
    for (var i = 0; i < arrays.length(keys); i = i + 1) {
        var key = arrays.get(keys, i)
        if (strings.is_empty(key)) {
            continue
        }
        var value = json.get(document, key)
        var prefix = spaces(indentation) + key + ":"
        if (strings.starts_with(value, "{") && value != "{}") {
            output = output + prefix + "\n" + emit_object(value, indentation + 2)
        } elif (strings.starts_with(value, "[") && value != "[]") {
            output = output + prefix + "\n" + emit_array(value, indentation + 2)
        } elif (value == "{}" || value == "[]") {
            output = output + prefix + " " + value + "\n"
        } else {
            output = output + prefix + " " + yaml_scalar(value) + "\n"
        }
    }
    return output
}

fun parse(view string text) -> string {
    var parser = Parser(text)
    return parser.parse_document()
}

fun stringify(view string document) -> string {
    var value = strings.trim(document)
    if (!json.is_valid(value) || !strings.starts_with(value, "{")) {
        throw "yaml.stringify: expected a JSON object"
    }
    if (value == "{}") {
        return ""
    }
    return emit_object(value, 0)
}
